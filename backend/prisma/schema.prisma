generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HR        @map("hr")
  CANDIDATE @map("candidate")
}

model User {
  userId           Int      @id @default(autoincrement()) @map("UserId")
  passwordHash     String   @db.VarChar(255) @map("Password")
  fullName         String   @db.VarChar(128) @map("FullName")
  email            String   @unique @db.VarChar(64) @map("Email")
  phoneNumber      String?  @db.VarChar(16) @map("PhoneNumber")
  role             Role     @default(CANDIDATE) @map("Role")

  dob              DateTime? @db.Date @map("DOB")
  gender           String?   @db.VarChar(16) @map("Gender")
  address          String?   @db.VarChar(256) @map("Address")

  avatar           String?   @db.VarChar(256) @map("Avatar")
  profileUrl       String?   @db.VarChar(128) @map("ProfileUrl")

  isVerified       Boolean   @default(false) @map("IsVerified")

  createdBy        Int       @default(1) @map("CreatedBy")
  createdDate      DateTime  @default(now()) @map("CreatedDate")
  updatedBy        Int       @default(1) @map("UpdatedBy")
  updatedDate      DateTime  @updatedAt @map("UpdatedDate")

  applications     Application[]

  @@map("user")
}

model Job {
  jobId        Int       @id @default(autoincrement()) @map("JobId")
  title        String    @db.VarChar(256) @map("Title")
  description  String    @map("Description")
  status       String    @default("open") @db.VarChar(32) @map("Status")

  createdBy    Int       @map("CreatedBy")
  createdDate  DateTime  @default(now()) @map("CreatedDate")
  updatedBy    Int       @default(1) @map("UpdatedBy")
  updatedDate  DateTime  @updatedAt @map("UpdatedDate")

  applications Application[]

  @@map("job")
}

model Application {
  applicationId Int       @id @default(autoincrement()) @map("ApplicationId")
  userId        Int       @map("UserId")
  jobId         Int       @map("JobId")
  resumeUrl     String    @db.VarChar(512) @map("ResumeUrl")
  coverLetter   String?   @map("CoverLetter")
  status        String    @default("pending") @db.VarChar(32) @map("Status")

  submittedAt   DateTime  @default(now()) @map("SubmittedAt")
  reviewedAt    DateTime? @map("ReviewedAt")
  reviewedBy    Int?      @map("ReviewedBy")

  user          User      @relation(fields: [userId], references: [userId])
  job           Job       @relation(fields: [jobId], references: [jobId])

  @@map("application")
}
